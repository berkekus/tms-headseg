# Per-user Obsidian layout, cache, and plugin preferences.
/knowledge/.obsidian/

# Local Python environments and generated bytecode.
.venv/
__pycache__/
*.py[cod]
.DS_Store

# Local reconstruction outputs must not enter version control.
m2m_*/
*.nii
*.nii.gz
*.msh
*.launcher.log
*.pth
*.pt
*.ckpt
/tools/e1_training/*.zip

# Local desktop packaging outputs and caches.
/tools/charm_gui/.build/
/tools/charm_gui/.build-cache/
/tools/charm_gui/dist/

# Generated artifacts, local reports and backups.
/outputs/
/tools/qa/FINDINGS.md

# Local secrets and private key material.
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.log
